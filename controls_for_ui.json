[
  {
    "name": "demo-steer-large-transfer-2fa",
    "ui_form_values": {
      "amount_pattern": "^[1-9][0-9]{4,}([.]0+)?$",
      "verified_2fa_pattern": "^(true|True)$",
      "steering_context_message": {
        "required_actions": ["request_2fa", "verify_2fa"],
        "retry_flags": {"verified_2fa": true},
        "reason": "Transfers >= $10,000 require identity verification via 2FA."
      }
    },
    "definition": {
      "description": "Require 2FA when the transfer is at least $10,000 AND is NOT already verified.",
      "enabled": true,
      "execution": "server",
      "scope": {
        "step_types": ["tool"],
        "stages": ["pre"]
      },
      "condition": {
        "and": [
          {
            "selector": {"path": "input.amount"},
            "evaluator": {
              "name": "regex",
              "config": {"pattern": "^[1-9][0-9]{4,}([.]0+)?$"}
            }
          },
          {
            "not": {
              "selector": {"path": "input.verified_2fa"},
              "evaluator": {
                "name": "regex",
                "config": {"pattern": "^(true|True)$"}
              }
            }
          }
        ]
      },
      "action": {
        "decision": "steer",
        "steering_context": {
          "message": "{\"required_actions\":[\"request_2fa\",\"verify_2fa\"],\"retry_flags\":{\"verified_2fa\":true},\"reason\":\"Transfers >= $10,000 require identity verification via 2FA.\"}"
        }
      },
      "tags": ["demo", "galileo", "banking", "steer", "2fa", "and", "not", "pre-tool"]
    }
  },
  {
    "name": "demo-deny-risky-transfer-composite",
    "ui_form_values": {
      "destination_pattern": "^(iran|north korea|syria|cuba|crimea)$",
      "destination_flags": ["IGNORECASE"],
      "fraud_score_pattern": "^(0[.][89][0-9]*|1([.]0+)?)$"
    },
    "definition": {
      "description": "Deny when the destination is sanctioned OR the fraud score is 0.8 or higher.",
      "enabled": true,
      "execution": "server",
      "scope": {
        "step_types": ["tool"],
        "stages": ["pre"]
      },
      "condition": {
        "or": [
          {
            "selector": {"path": "input.destination_country"},
            "evaluator": {
              "name": "regex",
              "config": {
                "pattern": "^(iran|north korea|syria|cuba|crimea)$",
                "flags": ["IGNORECASE"]
              }
            }
          },
          {
            "selector": {"path": "input.fraud_score"},
            "evaluator": {
              "name": "regex",
              "config": {"pattern": "^(0[.][89][0-9]*|1([.]0+)?)$"}
            }
          }
        ]
      },
      "action": {"decision": "deny"},
      "tags": ["demo", "galileo", "banking", "deny", "risk", "or", "pre-tool"]
    }
  }
]
