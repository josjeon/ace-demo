GALILEO_CONSOLE_URL=https://console-test-evals.gcp-dev.galileo.ai
GALILEO_API_URL=https://api-test-evals.gcp-dev.galileo.ai
GALILEO_API_KEY=<your-galileo-api-key>
GALILEO_PROJECT=test-evals
GALILEO_LOG_STREAM=test-evals
AGENT_CONTROL_URL=https://agent-control-test-evals.gcp-dev.galileo.ai
AGENT_CONTROL_AGENT_NAME=galileo-control-span-demo
AGENT_CONTROL_TARGET_TYPE=log_stream
AGENT_CONTROL_RUNTIME_AUTH_MODE=jwt
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
# Optional. Must be the real Galileo scorer ID; when omitted, scripted setup skips Luna.
# GALILEO_LUNA_SCORER_ID=<your-scorer-id>
AGENT_CONTROL_OTEL_ENABLED=true
AGENT_CONTROL_OTEL_ENDPOINT=https://api-test-evals.gcp-dev.galileo.ai/otel/v1/traces
# Optional. run_demo_otel.py builds these routing headers from GALILEO_API_KEY,
# GALILEO_PROJECT, and GALILEO_LOG_STREAM when this value is omitted.
# AGENT_CONTROL_OTEL_HEADERS='{"Galileo-API-Key":"<your-galileo-api-key>","project":"test-evals","logstream":"test-evals"}'
